#!/usr/bin/env bash
# Git pre-commit hook — runs before every commit.
# Blocks commits that: (1) have failing tests, (2) contain hardcoded secrets,
# (3) stage protected binary or secret files.
#
# Install: bash scripts/install_hooks.sh

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo "=== Pre-Commit Checks ==="

# ── 1. Blocked files ──────────────────────────────────────────────────────────
echo -n "  Checking for blocked staged files... "

STAGED=$(git diff --cached --name-only)

BLOCKED_FILES=(".env" "instance/data.db")
for f in "${BLOCKED_FILES[@]}"; do
  if echo "$STAGED" | grep -qF "$f"; then
    echo -e "${RED}FAIL${NC}"
    echo "  ERROR: '$f' must not be committed. Add it to .gitignore."
    exit 1
  fi
done

if echo "$STAGED" | grep -qE '(__pycache__|\.pyc$)'; then
  echo -e "${RED}FAIL${NC}"
  echo "  ERROR: Python cache files must not be committed. Add __pycache__/ to .gitignore."
  exit 1
fi

echo -e "${GREEN}OK${NC}"

# ── 2. Hardcoded secrets ──────────────────────────────────────────────────────
echo -n "  Checking for hardcoded secrets in staged .py files... "

PY_STAGED=$(echo "$STAGED" | grep '\.py$' || true)

if [ -n "$PY_STAGED" ]; then
  SECRET_FOUND=""
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if git show ":$f" | grep -qiE '(secret_key|password|api_key|token)\s*=\s*['"'"'"][^'"'"'"]{4,}['"'"'"]'; then
      SECRET_FOUND="$f"
      break
    fi
  done <<< "$PY_STAGED"

  if [ -n "$SECRET_FOUND" ]; then
    echo -e "${RED}FAIL${NC}"
    echo "  ERROR: Possible hardcoded secret in '$SECRET_FOUND'."
    echo "         Use os.environ.get() or python-dotenv instead."
    exit 1
  fi
fi

echo -e "${GREEN}OK${NC}"

# ── 3. Run tests ──────────────────────────────────────────────────────────────
if [ -d "tests" ] && command -v python &>/dev/null; then
  echo -n "  Running test suite... "
  if python -m pytest tests/ -q --tb=no 2>&1 | tail -1 | grep -qE '^[0-9]+ passed'; then
    echo -e "${GREEN}OK${NC}"
  else
    echo -e "${YELLOW}WARNING${NC}"
    echo "  Tests did not all pass. Run 'python scripts/test_runner.py' for details."
    echo "  Commit proceeding (use --no-verify to skip this check if intentional)."
  fi
fi

echo -e "${GREEN}=== All pre-commit checks passed ===${NC}"
echo ""
exit 0
